  "additionalProperties": true,
  "description": "Grupos: internal = sensores en la tierra (humedad capacitiva v1.2, DS18B20); external = fuera de la tierra (BME680, DHT11, LDR). Unidades en el nombre del campo. Datos faltantes: null + bandera, nunca un valor inventado. Regla adicional (no expresable aquí): scenario solo si source = 'simulated'.",
  "examples": [
    {
      "calibration": {
        "date": "2026-11-14",
        "ds18b20_offsets_c": [
          0.1,
          -0.2,
          0.0
        ],
        "moisture_method": "gravimetric_3pt"
      },
      "external": {
        "bme680": {
          "gas_kohm": 85.4,
          "p_hpa": 965.0,
          "rh_pct": 48.2,
          "t_c": 26.1
        },
        "dht11": {
          "rh_pct": 50.0,
          "t_c": 26.0
        },
        "ldr": {
          "light_pct": 45.0,
          "mv": 1480,
          "r_fixed_ohm": 2200,
          "raw": 1830
        }
      },
      "internal": {
        "depth_cm": 7,
        "zones": [
          {
            "flags": [],
            "id": "A",
            "soil_moisture_raw": 2710,
            "soil_moisture_vwc": 0.11,
            "soil_temp_c": 24.6
          }
        ]
      },
      "node_id": "rotasat-node-01",
      "quality_flags": [],
      "scenario": "S4",
      "schema_version": "1.0",
      "source": "simulated",
      "ts": "2026-11-14T20:15:00Z"
    }
  ],
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "node_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "simulated",
        "wokwi",
        "physical"
      ],
      "title": "Source",
      "type": "string"
    },
    "scenario": {
      "anyOf": [
        {
          "maxLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario"
    },
    "ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UTC ISO-8601 (NTP). Si falta, se usa received_at",
      "title": "Ts"
    },
    "internal": {
      "$ref": "#/$defs/Internal"
    },
    "external": {
      "$ref": "#/$defs/External"
    },
    "calibration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Calibration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    }
  },
  "required": [
    "node_id",
    "source"
  ],
  "title": "FarmealoTu · lectura del nodo de campo v1 (plan 9.2)",
  "type": "object",
